{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "specialistDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specialist_id",
        "version",
        "specialization",
        "capabilities",
        "forbidden_scope",
        "required_knowledge_domains",
        "required_skills",
        "required_lenses",
        "tool_profile",
        "project_compatibility",
        "task_contract",
        "work_report_contract",
        "learning_output_contract",
        "quality_gates",
        "scaling_policy",
        "quarantine_policy",
        "quarantined",
        "deprecated"
      ],
      "properties": {
        "specialist_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "specialization": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbidden_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_knowledge_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_lenses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_profile": {
          "type": "object"
        },
        "project_compatibility": {
          "type": "object"
        },
        "task_contract": {
          "type": "object"
        },
        "work_report_contract": {
          "type": "object"
        },
        "learning_output_contract": {
          "type": "object"
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scaling_policy": {
          "type": "object"
        },
        "quarantine_policy": {
          "type": "object"
        },
        "quarantined": {
          "type": "boolean"
        },
        "deprecated": {
          "type": "boolean"
        }
      }
    },
    "workerInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "primary_specialization",
        "role"
      ],
      "properties": {
        "worker_id": {
          "$ref": "#/$defs/id"
        },
        "primary_specialization": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "WORKER",
            "MANAGER"
          ]
        }
      }
    },
    "workerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "specialization",
        "read_only",
        "owned_write_paths"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "specialization": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        },
        "owned_write_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workerQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "items"
      ],
      "properties": {
        "worker_id": {
          "$ref": "#/$defs/id"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "state"
            ],
            "properties": {
              "task_id": {
                "$ref": "#/$defs/id"
              },
              "state": {
                "enum": [
                  "BACKLOG",
                  "READY",
                  "RUNNING",
                  "WAITING_DEPENDENCY",
                  "WAITING_EVIDENCE",
                  "BLOCKED",
                  "REPORTING",
                  "REPORT_READY",
                  "VERIFYING",
                  "DONE",
                  "FAILED",
                  "SUPERSEDED"
                ]
              }
            }
          }
        }
      }
    },
    "taskAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "worker_id",
        "task_id",
        "specialist_id",
        "specialization",
        "read_only"
      ],
      "properties": {
        "assignment_id": {
          "$ref": "#/$defs/id"
        },
        "worker_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "specialist_id": {
          "$ref": "#/$defs/id"
        },
        "specialization": {
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        }
      }
    },
    "writeLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "worker_id",
        "worktree",
        "paths",
        "expires_at"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "worker_id": {
          "$ref": "#/$defs/id"
        },
        "worktree": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "workerReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_label",
        "summary"
      ],
      "properties": {
        "evidence_label": {
          "const": "REPORTED_BY_WORKER"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "learningOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learnings",
        "knowledge_gaps",
        "contradictions"
      ],
      "properties": {
        "learnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knowledge_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": []
}
