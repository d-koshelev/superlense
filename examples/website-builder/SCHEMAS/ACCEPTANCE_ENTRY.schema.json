{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superlense:website-builder:acceptance-entry:1.0.0",
  "title": "ACCEPTANCE_ENTRY",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "acceptance_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "authority": {
      "enum": [
        "AUTOMATED",
        "COPILOT",
        "OPERATOR",
        "CLIENT"
      ]
    },
    "decision": {
      "enum": [
        "PENDING",
        "PASS",
        "ACCEPTED",
        "REJECTED",
        "REVISION_REQUIRED"
      ]
    },
    "statement": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "acceptance_id",
    "project_id",
    "target_id",
    "authority",
    "decision",
    "statement",
    "evidence_ids",
    "decided_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "authority": {
            "enum": [
              "OPERATOR",
              "CLIENT"
            ]
          },
          "decision": {
            "enum": [
              "ACCEPTED",
              "REJECTED",
              "REVISION_REQUIRED"
            ]
          }
        },
        "required": [
          "authority",
          "decision"
        ]
      },
      "then": {
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1
          },
          "decided_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "statement",
          "evidence_ids",
          "decided_at"
        ]
      }
    }
  ]
}
