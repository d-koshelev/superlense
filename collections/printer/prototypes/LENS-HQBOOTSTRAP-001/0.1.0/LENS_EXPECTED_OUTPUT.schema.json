{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "records",
    "unknowns",
    "blockers",
    "operator_overview"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "compiled",
        "held",
        "failed"
      ]
    },
    "records": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "operator_overview": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
