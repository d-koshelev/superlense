{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "lens_id",
    "version",
    "task_id",
    "status"
  ],
  "properties": {
    "lens_id": {
      "const": "WEB-PRIMARY-IDENTITY-VISIBILITY-001"
    },
    "version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "mounted",
        "applied",
        "not_triggered",
        "failed",
        "blocked_completion",
        "operator_overridden"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operator_override": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "explicit": {
          "const": true
        },
        "decision_owner": {
          "const": "OPERATOR"
        },
        "known_consequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "explicit",
        "decision_owner",
        "known_consequences"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
