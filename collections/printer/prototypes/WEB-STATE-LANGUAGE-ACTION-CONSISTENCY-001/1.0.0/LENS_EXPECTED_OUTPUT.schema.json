{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "lens_id",
    "status",
    "evidence"
  ],
  "properties": {
    "lens_id": {
      "const": "WEB-STATE-LANGUAGE-ACTION-CONSISTENCY-001"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "OVERRIDDEN"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operator_override": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
