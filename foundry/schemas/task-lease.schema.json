{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/task-lease.schema.json",
  "type": "object",
  "required": ["lease_id", "task_id", "holder", "exclusive", "issued_at", "status"],
  "properties": {
    "lease_id": {"type": "string"},
    "task_id": {"pattern": "^LFND-[0-9]{4}$"},
    "holder": {"const": "Universal Lense Foundry Coordinator"},
    "exclusive": {"const": true},
    "issued_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["active", "released", "stale", "cancelled"]}
  }
}

