{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/overlay-action-request.schema.json",
  "type": "object",
  "required": ["action", "reason"],
  "properties": {
    "action": {"enum": ["request_refresh_review", "request_external_test", "request_gate_review", "request_catalog_review"]},
    "reason": {"type": "string", "minLength": 3, "maxLength": 500},
    "target_ref": {"type": ["string", "null"], "maxLength": 160}
  },
  "additionalProperties": false
}

